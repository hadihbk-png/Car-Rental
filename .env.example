# Copy to .env.local and fill in. Never put real values in this file.

# --- Database ---
# Local: postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Cloud (Neon via Vercel Marketplace): DATABASE_URL = pooled URL (app requests),
# DATABASE_URL_UNPOOLED = direct URL (migrations during `vercel-build`). Needs btree_gist.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=
QA_DATABASE_URL=
# Optional: max connections per server instance (default 10)
DATABASE_POOL_MAX=
# Local only: superuser link for creating/dropping databases
POSTGRES_ADMIN_URL=

# --- App ---
APP_URL=http://localhost:3000
# Optional: debug | info | warn | error (structured JSON server logs)
LOG_LEVEL=
# Optional: VAT in basis points (default 500 = 5% UAE VAT)
VAT_RATE_BPS=

# --- Auth (Better Auth, email + password) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra comma-separated origins allowed to call /api/auth (e.g. preview URLs)
BETTER_AUTH_TRUSTED_ORIGINS=

# --- QR codes (signs voucher QR payloads; min 16 chars) ---
QR_SIGNING_SECRET=

# --- Payments ---
# fake = local test provider (default); stripe = Stripe test mode (PaymentIntents,
# deposit = manual-capture PaymentIntent). Switching needs only these settings.
PAYMENT_PROVIDER=fake
# Webhook signing secret: fake provider shared secret, or Stripe's whsec_... endpoint secret
PAYMENT_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_WEBHOOK_DUPLICATES=0
FAKE_PAYMENTS_STATE_FILE=.local/fake-payments.json
# Stripe only: secret key (sk_test_...) server-side; publishable key (pk_test_...) for Stripe Elements
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# --- File uploads ---
# local = private folder on disk (default); vercel-blob = Vercel Blob (public/ keys stored
# public, everything else private and served only through the authorised /api/files routes)
STORAGE_DRIVER=local
UPLOADS_DIR=storage/uploads
# vercel-blob only (provided by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=

# --- Scheduled jobs ---
# Bearer token Vercel Cron sends to GET /api/cron/release-expired-holds
CRON_SECRET=

# --- Seed accounts (pnpm db:seed; local/dev only) ---
SEED_ADMIN_EMAIL=admin@driveeasy.test
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@driveeasy.test
SEED_CUSTOMER_PASSWORD=
