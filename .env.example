# Copy to .env.local and fill in. Never put real values in this file.
# Platforms: Local (.env.local) | Vercel (Project > Settings > Environment Variables)
#            | Netlify (Site configuration > Environment variables). Netlify itself provides
#            URL, DEPLOY_URL, DEPLOY_PRIME_URL, CONTEXT and NETLIFY - do not set those.

# --- Database ---
# Local: postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Vercel (Neon via Marketplace): DATABASE_URL = pooled URL (app requests),
#   DATABASE_URL_UNPOOLED = direct URL (migrations in `vercel-build`). Needs btree_gist.
# Netlify DB (Neon): sets NETLIFY_DATABASE_URL (pooled) and NETLIFY_DATABASE_URL_UNPOOLED
#   (direct) automatically; they are used when DATABASE_URL* are not set.
# App: DATABASE_URL || NETLIFY_DATABASE_URL. Migrations: DATABASE_URL_UNPOOLED ||
#   NETLIFY_DATABASE_URL_UNPOOLED || DATABASE_URL || NETLIFY_DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=
QA_DATABASE_URL=
# Optional: max connections per server instance (default 10)
DATABASE_POOL_MAX=
# Local only: superuser link for creating/dropping databases
POSTGRES_ADMIN_URL=

# --- App ---
# Optional on Vercel/Netlify (falls back to the platform URL: Netlify URL / deploy-preview URL,
# Vercel VERCEL_URL). Set it when you use a custom domain.
APP_URL=http://localhost:3000
# Optional: debug | info | warn | error (structured JSON server logs)
LOG_LEVEL=
# Optional: VAT in basis points (default 500 = 5% UAE VAT)
VAT_RATE_BPS=

# --- Auth (Better Auth, email + password) ---
# Required everywhere. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional on Vercel/Netlify (same fallback as APP_URL). Set it for a custom domain.
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra comma-separated origins allowed to call /api/auth (deploy URLs are added automatically)
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: comma-separated request header(s) carrying the real client IP for rate limiting.
# Default: Netlify x-nf-client-connection-ip; Vercel x-real-ip, x-vercel-forwarded-for;
# elsewhere x-forwarded-for. Only use headers your platform edge sets (clients can forge others).
AUTH_IP_HEADER=

# --- QR codes (signs voucher QR payloads; min 16 chars) ---
QR_SIGNING_SECRET=

# --- Payments ---
# fake = local test provider (default); stripe = Stripe test mode (PaymentIntents,
# deposit = manual-capture PaymentIntent). Switching needs only these settings.
# A deployed production build (Netlify/Vercel) refuses `fake` unless ALLOW_FAKE_PAYMENTS=true.
PAYMENT_PROVIDER=fake
# Webhook signing secret: fake provider shared secret, or Stripe's whsec_... endpoint secret
PAYMENT_WEBHOOK_SECRET=
# Demo sites only: "true" allows PAYMENT_PROVIDER=fake in a deployed production build (no real money)
ALLOW_FAKE_PAYMENTS=
# Fake provider only. Webhook URL: an explicit value wins (empty disables delivery);
# when unset it falls back to ${URL}/api/webhooks/payments (Netlify).
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_WEBHOOK_DUPLICATES=0
# file = JSON file on disk (local; default) | netlify-blobs = Netlify Blobs (demo deploys on Netlify)
FAKE_PAYMENTS_STORE=file
FAKE_PAYMENTS_STATE_FILE=.local/fake-payments.json
# Stripe only: secret key (sk_test_...) server-side; publishable key (pk_test_...) for Stripe Elements
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=
# Optional: allow a live (non sk_test_) Stripe key. Leave unset.
ALLOW_LIVE_PAYMENTS=

# --- File uploads ---
# local = private folder on disk (default; refused on Netlify, where disks do not persist)
# vercel-blob = Vercel Blob (public/ keys stored public, everything else private)
# netlify-blobs = Netlify Blobs (one store; every file served through the authorised /api/files routes)
STORAGE_DRIVER=local
UPLOADS_DIR=storage/uploads
# vercel-blob only (provided by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=
# netlify-blobs only, all optional: store name (default driveeasy-files). Credentials come from
# the Netlify Functions environment; set SITE_ID/TOKEN only to reach the store from elsewhere
# (e.g. running `pnpm db:seed` locally against the Netlify store).
NETLIFY_BLOBS_STORE=
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# --- Scheduled jobs ---
# Bearer token for /api/cron/release-expired-holds. Required on Vercel (Vercel Cron sends it)
# and on Netlify (netlify/functions/release-expired-holds.mts sends it every 5 minutes).
CRON_SECRET=

# --- Seed accounts (pnpm db:seed; local/dev only) ---
SEED_ADMIN_EMAIL=admin@driveeasy.test
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@driveeasy.test
SEED_CUSTOMER_PASSWORD=
