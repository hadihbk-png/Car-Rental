# Copy to .env.local and fill in. Never put real values in this file.

# --- Database ---
# Local: postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Cloud: the managed PostgreSQL connection string (must have btree_gist available)
DATABASE_URL=
TEST_DATABASE_URL=
# Local only: superuser link for creating/dropping databases
POSTGRES_ADMIN_URL=

# --- App ---
APP_URL=http://localhost:3000

# --- Auth (Better Auth, email + password) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- QR codes ---
QR_SIGNING_SECRET=

# --- Payments ---
# fake = local test provider. Set to the real provider's name once its adapter exists.
PAYMENT_PROVIDER=fake
# Shared secret used to sign/verify payment webhooks
PAYMENT_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_WEBHOOK_DUPLICATES=0
FAKE_PAYMENTS_STATE_FILE=.local/fake-payments.json
# Future cloud payment provider (e.g. Stripe)
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# --- File uploads ---
# local = private folder on disk. Set to the cloud driver once its adapter exists.
STORAGE_DRIVER=local
UPLOADS_DIR=storage/uploads
# Future cloud object storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Scheduled jobs ---
# Bearer token the cloud scheduler sends to /api/cron/release-expired-holds
CRON_SECRET=
