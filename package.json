{
  "name": "driveeasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db-check.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db-migrate.mts",
    "db:studio": "drizzle-kit studio",
    "jobs:release-holds": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/release-expired-holds.mts",
    "test:integration": "vitest run --project integration",
    "db:reset": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db-reset.mts",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.mts",
    "test:db": "vitest run --project engine",
    "vercel-build": "node --conditions=react-server --import tsx scripts/db-migrate.mts && next build"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
